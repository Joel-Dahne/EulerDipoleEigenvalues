module

public import EulerDipoleEigenvalues.Transport.WeightedGains.TransportRotations
public import EulerDipoleEigenvalues.Transport.WeightedForcing.SaddleTransportWeights

/-!
# Smooth transport pairs and their first weighted mass

Blueprint: `lem:smooth-transport-pair`.

For a smooth profile P, set v = -i L₀P/λ and f = P-v. Then v+f=P
and L₀P=iλv. Each sine coefficient vanishes linearly at every saddle,
so v/d is controlled by the ordinary gradient of P on a bounded set.
-/

@[expose] public section

noncomputable section
namespace EulerDipoleEigenvalues
open MeasureTheory Set Filter
open scoped ContDiff

/-- The transport derivative vanishes at every saddle, for any raw profile. -/
theorem classicalL0_eq_zero_of_mem_saddleSet {p : ℝ × ℝ} (hp : p ∈ saddleSet)
    (P : ℝ × ℝ → ℂ) : classicalL0 P p = 0 := by
  rcases hp with ⟨m, n, _, rfl⟩
  simp [classicalL0, Real.sin_int_mul_pi]

private theorem memLp_sin_mul_div_saddleDist {U : Set (ℝ × ℝ)}
    {D : ℝ × ℝ → ℂ} (hD : MemLp D 2 (volume.restrict U)) (j : Fin 2) :
    MemLp (fun p ↦ (Real.sin (if j = 0 then p.1 else p.2) : ℂ) * D p /
      (saddleDist p : ℂ)) 2 (volume.restrict U) := by
  have hs : Continuous (fun p : ℝ × ℝ ↦
      (Real.sin (if j = 0 then p.1 else p.2) : ℂ)) := by
    by_cases hj : j = 0
    · simp only [ite_eq_left hj]; fun_prop
    · simp only [ite_eq_right hj]; fun_prop
  have hd : Continuous (fun p : ℝ × ℝ ↦ (saddleDist p : ℂ)) :=
    Complex.continuous_ofReal.comp (Metric.continuous_infDist_pt saddleSet)
  apply hD.of_le_mul (c := 1)
    ((hs.aestronglyMeasurable.mul hD.aestronglyMeasurable).div₀ hd.aestronglyMeasurable)
  exact Eventually.of_forall fun p ↦ by
    change ‖(Real.sin (if j = 0 then p.1 else p.2) : ℂ) * D p /
      (saddleDist p : ℂ)‖ ≤ 1 * ‖D p‖
    by_cases hzero : saddleDist p = 0
    · simp [hzero]
    have hp : 0 < saddleDist p := lt_of_le_of_ne Metric.infDist_nonneg (Ne.symm hzero)
    simp only [one_mul, norm_div, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hp]
    apply (div_le_iff₀ hp).mpr
    simpa only [mul_comm] using
      mul_le_mul_of_nonneg_right (abs_sin_axis_le_saddleDist p j) (norm_nonneg (D p))

/-- A smooth transport derivative gains one saddle-distance weight on every
bounded open set, using actual L² norms of its ordinary partial derivatives. -/
theorem memLp_classicalL0_div_saddleDist {U : Set (ℝ × ℝ)} (hU : IsOpen U)
    (hb : Bornology.IsBounded U) {P : ℝ × ℝ → ℂ} (hP : ContDiff ℝ 1 P) :
    MemLp (fun p ↦ classicalL0 P p / (saddleDist p : ℂ)) 2 (volume.restrict U) := by
  have hc : IsCompact (closure U) := hb.isCompact_closure
  have hx : Continuous (partialX P) := by
    simpa [coordPartial] using (contDiff_coordPartial (n := 0) 0 (by simpa using hP)).continuous
  have hy : Continuous (partialY P) := by
    simpa [coordPartial] using (contDiff_coordPartial (n := 0) 1 (by simpa using hP)).continuous
  have hX := memLp_sin_mul_div_saddleDist (memLp_two_restrict_of_continuous hx hU hc) 1
  have hY := memLp_sin_mul_div_saddleDist (memLp_two_restrict_of_continuous hy hU hc) 0
  convert hX.sub hY using 1
  funext p
  simp [classicalL0, Complex.real_smul, sub_div]

/-- The explicit smooth pair generated by a profile, with its first mass gain. -/
theorem smooth_transport_pair {lam : ℝ} (hlam : lam ≠ 0)
    {U : Set (ℝ × ℝ)} (hU : IsOrbitUnion U) (hb : Bornology.IsBounded U)
    {P : ℝ × ℝ → ℂ} (hP : ContDiff ℝ ∞ P) :
    let v := fun p ↦ (-Complex.I / (lam : ℂ)) * classicalL0 P p
    let f := fun p ↦ P p - v p
    IsTransportPair lam U v f ∧
      ContDiff ℝ ∞ v ∧ ContDiff ℝ ∞ f ∧
      (∀ p ∈ saddleSet, f p = P p) ∧
      MemLp (fun p ↦ v p / (saddleDist p : ℂ)) 2 (volume.restrict U) := by
  let a : ℂ := -Complex.I / (lam : ℂ)
  let v : ℝ × ℝ → ℂ := fun p ↦ a * classicalL0 P p
  let f : ℝ × ℝ → ℂ := fun p ↦ P p - v p
  have hc : IsCompact (closure U) := hb.isCompact_closure
  have hx : ContDiff ℝ ∞ (partialX P) := by
    simpa [coordPartial] using contDiff_coordPartial_top 0 hP
  have hy : ContDiff ℝ ∞ (partialY P) := by
    simpa [coordPartial] using contDiff_coordPartial_top 1 hP
  have hL : ContDiff ℝ ∞ (classicalL0 P) := by unfold classicalL0; fun_prop
  have hv : ContDiff ℝ ∞ v := contDiff_const.mul hL
  have hf : ContDiff ℝ ∞ f := hP.sub hv
  have hP1 : ContDiff ℝ 1 P := hP.of_le (by simp)
  have hw : HasWeakL0On U P (classicalL0 P) := by
    convert (hasWeakPartialOn_of_contDiff hP1 U 0).hasWeakL0On hU.1
      (hasWeakPartialOn_of_contDiff hP1 U 1) using 1
    funext p
    simp [classicalL0, coordPartial, Complex.real_smul]
  refine ⟨⟨hlam, hU, memLp_two_restrict_of_continuous hv.continuous hU.1 hc,
    memSobolevLocOn_of_contDiff 2 univ (hf.of_le (by simp)) U hU.1 hc (subset_univ _), ?_⟩,
    hv, hf, ?_, ?_⟩
  · convert hw using 1 <;> funext p
    · ring
    · field_simp [Complex.ofReal_ne_zero.mpr hlam]
      simp [Complex.I_sq]
  · intro p hp
    simp [classicalL0_eq_zero_of_mem_saddleSet hp]
  · simpa only [v, mul_div_assoc] using (memLp_classicalL0_div_saddleDist hU.1 hb hP1).const_mul a

/-- Every smooth profile generates a smooth transport pair with a genuine
first weighted mass norm and forcing values equal to the profile at all saddles. -/
theorem exists_smooth_transport_pair {lam : ℝ} (hlam : lam ≠ 0)
    {U : Set (ℝ × ℝ)} (hU : IsOrbitUnion U) (hb : Bornology.IsBounded U)
    {P : ℝ × ℝ → ℂ} (hP : ContDiff ℝ ∞ P) :
    ∃ v f : ℝ × ℝ → ℂ, IsTransportPair lam U v f ∧
      ContDiff ℝ ∞ v ∧ ContDiff ℝ ∞ f ∧
      (∀ p ∈ saddleSet, f p = P p) ∧
      MemLp (fun p ↦ v p / (saddleDist p : ℂ)) 2 (volume.restrict U) := by
  exact ⟨_, _, smooth_transport_pair hlam hU hb hP⟩

end EulerDipoleEigenvalues
