@[expose] public section

/-- The first strip uses the corner certificate and two short-log rectangles. -/
theorem mixed_odd_b_first_strip {h k : ℝ} (hh : h ∈ Icc (1 / 2) 1)
    (hk : k ∈ Icc 0 1) : 0 ≤ mixedOddBResidual (h, k) := by
  rcases le_or_gt h (15 / 16) with hl | hl
  · let x := (16 * h - 8) / 7
    have hx : x ∈ Icc (0 : ℝ) 1 :=
      ⟨by dsimp [x]; linarith only [hh.1], by dsimp [x]; linarith only [hl]⟩
    have he : (8 + 7 * x) / 16 = h := by dsimp [x]; ring
    have hp : 0 ≤ h := by linarith only [hh.1]
    have hr : 0 < 2 - h ^ 2 - k ^ 2 := by
      have hlt : h < 1 := hl.trans_lt (by norm_num)
      linarith only [pow_lt_one₀ hp hlt two_ne_zero, pow_le_one₀ hk.1 hk.2 (n := 2)]
    apply first_of_endpoints hh hk hr
    · exact first_endpoint_nonneg _ _ firstLowerLeft_check (by norm_num [firstLowerLeftScale])
        (he ▸ firstLowerLeft_power x k) hx hk
    · exact first_endpoint_nonneg _ _ firstUpperLeft_check (by norm_num [firstUpperLeftScale])
        (he ▸ firstUpperLeft_power x k) hx hk
  rcases le_or_gt k (15 / 16) with kl | kl
  · let x := 16 * h - 15
    let y := 16 * k / 15
    have hx : x ∈ Icc (0 : ℝ) 1 :=
      ⟨by dsimp [x]; linarith only [hl], by dsimp [x]; linarith only [hh.2]⟩
    have hy : y ∈ Icc (0 : ℝ) 1 :=
      ⟨by dsimp [y]; linarith only [hk.1], by dsimp [y]; linarith only [kl]⟩
    have he : (15 + x) / 16 = h := by dsimp [x]; ring
    have hf : 15 * y / 16 = k := by dsimp [y]; ring
    have hp : 0 ≤ h := by linarith only [hh.1]
    have hr : 0 < 2 - h ^ 2 - k ^ 2 := by
      have hlt : k < 1 := kl.trans_lt (by norm_num)
      linarith only [pow_le_one₀ hp hh.2 (n := 2), pow_lt_one₀ hk.1 hlt two_ne_zero]
    apply first_of_endpoints hh hk hr
    · exact first_endpoint_nonneg _ _ firstLowerRight_check (by norm_num [firstLowerRightScale])
        (he ▸ hf ▸ firstLowerRight_power x y) hx hy
    · exact first_endpoint_nonneg _ _ firstUpperRight_check (by norm_num [firstUpperRightScale])
        (he ▸ hf ▸ firstUpperRight_power x y) hx hy
  exact mixed_odd_b_residual_corner ⟨hl.le, hh.2⟩ ⟨kl.le, hk.2⟩

end

