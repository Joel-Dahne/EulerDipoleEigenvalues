noncomputable section

private def firstLower (h k : ℝ) : ℝ :=
  6 * h * (1 + h) * mixedOddBA h k -
    (12 * h * (1 - h) + (1 - h) ^ 3) * mixedOddBB h k

private def firstUpper (h k : ℝ) : ℝ :=
  (1 + h) * mixedOddBA h k - 2 * (1 - h) * mixedOddBB h k

private theorem first_log_bounds {h : ℝ} (hh : 0 < h) (h1 : h ≤ 1) :
    -(12 * h * (1 - h) + (1 - h) ^ 3) / (6 * h * (1 + h)) ≤ Real.log h ∧
      Real.log h ≤ -(2 * (1 - h)) / (1 + h) := by
  let t := (1 - h) / (1 + h)
  have hp : 0 < 1 + h := by positivity
  have ht : 0 ≤ t := div_nonneg (sub_nonneg.mpr h1) hp.le
  have ht1 : t < 1 := (div_lt_one hp).2 (by linarith)
  have hr : (1 + t) / (1 - t) = h⁻¹ := by
    have hn : 1 - t ≠ 0 := (sub_pos.mpr ht1).ne'
    apply (div_eq_iff hn).2
    dsimp [t]
    field_simp [hh.ne', hp.ne']
    ring
  obtain ⟨hl, hu⟩ := certificate_log_cayley_bounds ht ht1
  rw [hr, Real.log_inv] at hl hu
  have hd : 1 - t ^ 2 = 4 * h / (1 + h) ^ 2 := by
    dsimp [t]
    field_simp [hp.ne']
    ring
  have he : -(2 * t + 2 * t ^ 3 / (3 * (1 - t ^ 2))) =
      -(12 * h * (1 - h) + (1 - h) ^ 3) / (6 * h * (1 + h)) := by
    rw [hd]
    dsimp [t]
    field_simp [hh.ne', hp.ne']
    ring
  constructor
  · rw [← he]
    linarith only [hu]
  · calc
      Real.log h ≤ -(2 * t) := by linarith only [hl]
      _ = _ := by simp [t, mul_div_assoc, neg_div]

private theorem first_of_endpoints {h k : ℝ} (hh : h ∈ Icc (1 / 2) 1)
    (hk : k ∈ Icc 0 1) (hr : 0 < 2 - h ^ 2 - k ^ 2)
    (hl : 0 ≤ firstLower h k) (hu : 0 ≤ firstUpper h k) :
    0 ≤ mixedOddBResidual (h, k) := by
  have hp : 0 < h := (by norm_num : (0 : ℝ) < 1 / 2).trans_le hh.1
  let lo := -(12 * h * (1 - h) + (1 - h) ^ 3) / (6 * h * (1 + h))
  let hi := -(2 * (1 - h)) / (1 + h)
  have hLo : 0 ≤ mixedOddBA h k + mixedOddBB h k * lo := by
    have hd : 0 < 6 * h * (1 + h) := by positivity
    have he : 6 * h * (1 + h) * (mixedOddBA h k + mixedOddBB h k * lo) =
        firstLower h k := by
      unfold lo firstLower
      field_simp [hd.ne']
      ring
    exact nonneg_of_mul_nonneg_right (he.symm ▸ hl) hd
  have hHi : 0 ≤ mixedOddBA h k + mixedOddBB h k * hi := by
    have hd : 0 < 1 + h := by positivity
    have he : (1 + h) * (mixedOddBA h k + mixedOddBB h k * hi) = firstUpper h k := by
      unfold hi firstUpper
      field_simp [hd.ne']
      ring
    exact nonneg_of_mul_nonneg_right (he.symm ▸ hu) hd
  obtain ⟨hlo, hhi⟩ := first_log_bounds hp hh.2
  have hc := certificate_affine_in_log (show Real.log h ∈ Icc lo hi from ⟨hlo, hhi⟩) hLo hHi
  rw [← mixed_odd_b_cleared_affine, mixed_odd_b_clear h k hp
    (add_pos_of_pos_of_nonneg hp hk.1).ne' hr.ne'] at hc
  exact nonneg_of_mul_nonneg_right hc
    (mul_pos (mul_pos (by norm_num) (pow_pos (add_pos_of_pos_of_nonneg hp hk.1) _)) hr)

private theorem first_endpoint_nonneg {n m : ℕ} (p : BernsteinIntTable n m)
    (tree : BernsteinMidTree) (hc : tree.check (bernsteinIntFromPower p) = true)
    {D v x y : ℝ} (hD : 0 < D) (he : bernsteinIntPowerEval p x y = D * v)
    (hx : x ∈ Icc 0 1) (hy : y ∈ Icc 0 1) : 0 ≤ v := by
  have h := tree.power_nonneg p hc hx hy
  rw [he] at h
  exact nonneg_of_mul_nonneg_right h hD

